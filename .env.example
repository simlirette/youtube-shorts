# ==============================================================================
# YOUTUBE SHORTS ENGINE — ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your credentials.
# ==============================================================================

# Application Environment
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Mock Provider Toggles (Set to 'true' for local zero-dependency execution)
MOCK_LLM=true
MOCK_SEARCH=true
MOCK_TTS=true
MOCK_IMAGE=true
MOCK_VIDEO=true
MOCK_ASSETS=true
MOCK_STORAGE=true
MOCK_YOUTUBE=true

# Database Configuration (PostgreSQL)
# Local Docker or hosted Supabase/PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtube_shorts
# Optional SQLite fallback for quick zero-install local tests (e.g. ./database/dev.sqlite)
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./database/dev.sqlite

# LLM Providers (OpenAI, Gemini, Anthropic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
ANTHROPIC_API_KEY=

# Search Providers (Tavily, Serper, Brave)
TAVILY_API_KEY=
SERPER_API_KEY=

# Text-to-Speech Providers (ElevenLabs, OpenAI TTS, Edge TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Visual Generation & Stock Asset Providers
REPLICATE_API_TOKEN=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# YouTube Data API v3 & OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# Default upload privacy status: private | unlisted | public
YOUTUBE_DEFAULT_PRIVACY=private

# Storage (AWS S3 or Cloudflare R2 or local disk)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./output/storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Rendering Configuration
FFMPEG_PATH=ffmpeg
RENDER_OUTPUT_DIR=./output/renders
TEMP_DIR=./output/temp

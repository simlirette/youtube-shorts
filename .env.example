# ==============================================================================
# YOUTUBE SHORTS ENGINE — ENVIRONMENT CONFIGURATION
# Copy to .env. Never commit .env (it is gitignored).
# ==============================================================================

NODE_ENV=development
LOG_LEVEL=info            # debug | info | warn | error
LOG_FORMAT=text           # text | json

# Execution mode is never defaulted. Set here or pass --mode on every CLI call.
#   mock = deterministic local providers, isolated DB/output (output/mock, database/mock-*.sqlite)
#   live = real providers; any missing credential is a hard error (no mock fallback)
# PIPELINE_MODE=live

# ---- Providers (live mode) ---------------------------------------------------
LLM_PROVIDER=openai       # openai | gemini | claude_code ($0 per call on a claude.ai plan; docs/FREE_WORKFLOW.md)
LLM_FALLBACK_PROVIDER=none   # none | gemini | openai — per request, when the main LLM is busy or out of allowance
ASSET_PROVIDER=pixabay    # pixabay | pexels
PUBLISH_TARGET=local_export  # local_export (writes output/exports/<job>/) | youtube

# Claude Code CLI (LLM_PROVIDER=claude_code); never uses API-key billing
CLAUDE_CODE_PATH=            # empty = auto-detect
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_VERIFIER_MODEL=  # optional, e.g. haiku to stretch the plan allowance

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional separate model for claim entailment / fact review / media fit judging
OPENAI_VERIFIER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# $0 workflow (see docs/FREE_WORKFLOW.md): free AI Studio key, calls recorded at $0, capped below free quotas
GEMINI_FREE_TIER=false
GEMINI_FREE_RPM=8
GEMINI_FREE_RPD=200
GEMINI_THINKING_BUDGET=        # 0 = no "thinking" on Flash (saves output tokens and quota)

TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced  # basic (1 credit) | advanced (2 credits)
TAVILY_MONTHLY_CREDITS=0      # free plan: 1000 (searches are refused before the month's credits run out)
FREE_TIER_USAGE_FILE=         # default ~/.shorts-engine/free-tier-usage.json

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# eleven_multilingual_v2 = 1 credit/char (most natural) | eleven_flash_v2_5 = 0.5 credit/char (half the cost)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_SPEED=1.15     # 0.7-1.2; live: 1.2 measured 3.06 words/s after gap tightening (target 2.6-3.0)
# Check the account balance before each narration (the key needs the user_read permission).
ELEVENLABS_CREDIT_PREFLIGHT=true

PIXABAY_API_KEY=
PEXELS_API_KEY=

# YouTube Data API v3 (only when PUBLISH_TARGET=youtube)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=    # written by: pnpm cli youtube auth
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_CATEGORY_ID=27    # 27 Education | 28 Science & Technology
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true   # AI narration disclosure
# Unaudited Google Cloud projects can only upload PRIVATE videos. After passing the YouTube API audit,
# set true (+ YOUTUBE_DEFAULT_PRIVACY=public) to schedule public releases at PUBLISH_SLOTS.
YOUTUBE_PROJECT_AUDITED=false
PUBLISH_SLOTS=17:00       # comma list of local HH:MM
PUBLISH_TIMEZONE=America/New_York
MAX_UPLOADS_PER_DAY=3

# ---- Topic discovery (free audience signals) ---------------------------------------
DISCOVERY_MODE=gap        # gap = real viewer questions with measured demand | llm = model brainstorming
GAP_SEEDS=aviation:why do planes|aviation:why do pilots|maritime:why do ships|maritime:why are cargo ships|infrastructure:why are bridges|infrastructure:why do skyscrapers|infrastructure:why are runways|odd_laws:why is it illegal to|engineering:why do trains|engineering:how do submarines
GAP_MIN_SCORE=45          # 0-100: demand (long-form views) vs supply (existing Shorts)
GAP_MAX_PROBES=16         # YouTube searches per discovery run (free)
YTDLP_PATH=yt-dlp

# ---- Formats & preflight ---------------------------------------------------------------
# MICRO_EXPLAINER is the target format (statement/scene hook, answer by ~5 s, 2-4 causal facts, payoff,
# clause-level visual beats). QUESTION_ANSWER, THREE_REASONS and STORY remain available.
SHORT_FORMATS=MICRO_EXPLAINER
MEDIA_PREFLIGHT_MIN_CANDIDATES=3   # stock clips each scene needs before voice credits are spent
MEDIA_PREFLIGHT_MIN_BEAT_CANDIDATES=2   # per visual beat (one 2-3.5 s shot) in MICRO_EXPLAINER

# ---- Production variant (frozen per job at creation; resume never changes it) -----
HOOK_TYPE=statement       # statement | scene | question (question = experiments only)
DURATION_BAND=standard    # standard = 30-45 s | short = 25-35 s (experimental)
TITLE_CARD=true           # short title in the first 2.5 s, inside the caption safe area
CAPTION_STYLE=plain       # plain | highlight (one emphasised word per caption)
CTA_ENABLED=false         # calls to action are not generated yet
# One factor at a time: "id|factor|valueA,valueB", factor in hookType, durationBand, titleCard, music,
# captionStyle, voiceSpeed, format. Arms are assigned round-robin per job and recorded with the job.
# >= 8 aged Shorts per arm is a screening signal, not statistical significance.
EXPERIMENT=

# ---- Music bed (local, licensed, human-approved tracks only) ------------------------
# Tracks come from a manifest you maintain (see assets/music/README.md). Without an approved track
# the render records music as disabled and media QA reports the music criterion as NOT MET.
MUSIC_ENABLED=true
MUSIC_LIBRARY=./assets/music/library.json
MUSIC_BED_LU=20           # bed level below the narration (LU); ducked further under speech

# ---- Script editor (a separate model pass scoring hook/clarity/specificity/payoff 0-5) ----
EDITOR_ENABLED=true
EDITOR_MAX_REVISIONS=2    # writer revisions driven by editor notes; then the job fails closed
EDITOR_MIN_TOTAL=15
EDITOR_MIN_HOOK=4
EDITOR_MIN_PAYOFF=4

# ---- Narration continuity & pacing (measured on the narration stem) -----------------
SPEECH_START_MAX_SECONDS=0.3
MAX_SPEECH_GAP_SECONDS=0.4
NARRATION_GAP_TARGET_SECONDS=0.22   # longer pauses are cut to this (timestamps realigned)
PACE_MIN_WPS=2.6
PACE_MAX_WPS=3.0

# ---- Visual beats & framing -----------------------------------------------------------
MIN_SHOT_SECONDS=1.6
MAX_SHOT_SECONDS=4.0
MAX_UPSCALE=2.0           # landscape clips are cropped to fill 9:16 unless that upscales more than this
FULL_BLEED_MIN_RATIO=0.9
GRAPHICS_ENABLED=true     # Blender motion graphics for numbers/comparisons/processes/terms (if Blender is installed)
BLENDER_PATH=             # empty = auto-detect
GRAPHICS_MAX_SHARE=0.4    # at most this share of shots are graphics

# ---- Approval policy (defaults are manual = fail closed) ---------------------
APPROVAL_IDEA=manual      # manual | auto   (auto requires the deterministic score gate)
APPROVAL_SCRIPT=manual    # manual | auto   (auto requires script validation + fact review)
APPROVAL_FINAL=manual     # manual | auto_after_qa (auto only when media+content QA are publish-eligible)

# ---- Content contract ---------------------------------------------------------
SCRIPT_MIN_WORDS=100
SCRIPT_MAX_WORDS=118
# Slowest expected voice pace; config validation rejects SCRIPT_MAX_WORDS that cannot fit SHORT_MAX_SECONDS.
VOICE_MIN_WORDS_PER_SECOND=2.0
SCRIPT_HOOK_MAX_WORDS=7
SCRIPT_MAX_ATTEMPTS=4
SHORT_MIN_SECONDS=20
SHORT_MAX_SECONDS=60
MIN_VERIFIED_CLAIMS=3
# Editorial selectivity knob (not an objective quality line): 65 admitted ~75% of 20 real topics, 70 ~15%.
TOPIC_MIN_SCORE=65
MEDIA_MIN_RELEVANCE=0.3
LOUDNESS_TARGET_LUFS=-14
LOUDNESS_TOLERANCE_LU=2

# ---- Captions -----------------------------------------------------------------
CAPTION_FONT_FILE=./assets/fonts/Anton-Regular.ttf
CAPTION_FONT_NAME=Anton

# ---- Reliability ----------------------------------------------------------------
HTTP_TIMEOUT_MS=30000
LLM_TIMEOUT_MS=120000
TTS_TIMEOUT_MS=120000
DOWNLOAD_TIMEOUT_MS=180000
FFMPEG_TIMEOUT_MS=600000
MAX_DOWNLOAD_BYTES=157286400
PROVIDER_MAX_ATTEMPTS=3
JOB_LOCK_TTL_MINUTES=60

# ---- Cost estimates (ledger only, not billing) ----------------------------------
ELEVENLABS_USD_PER_1K_CHARS=0.22
TAVILY_USD_PER_CREDIT=0.008

# ---- Storage ----------------------------------------------------------------------
OUTPUT_DIR=./output
# SQLite: single process only. PostgreSQL (USE_SQLITE_FALLBACK=false + DATABASE_URL): multiple workers.
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./database/dev.sqlite
DATABASE_URL=
DB_CONNECT_TIMEOUT_MS=5000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- API (requires API_TOKEN; binds to API_HOST) ----------------------------------
PORT=3000
API_HOST=127.0.0.1
API_TOKEN=
API_CORS_ORIGIN=

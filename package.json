{
  "name": "youtube-shorts-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Automated faceless YouTube Shorts media-production engine",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "acceptance:campaign": "tsx scripts/acceptance-campaign.ts",
    "mechanism": "tsx scripts/make-mechanism-video.ts",
    "video": "tsx scripts/build-video.ts",
    "video:batch": "tsx scripts/build-video.ts",
    "base:freeze": "tsx scripts/freeze-base.ts",
    "cli": "tsx apps/cli/src/index.ts",
    "pipeline:mock": "tsx apps/cli/src/index.ts run --mode mock",
    "pipeline:live": "tsx apps/cli/src/index.ts run --mode live",
    "api": "tsx apps/api/src/index.ts",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@shorts/schemas": "workspace:*",
    "@shorts/core": "workspace:*",
    "@shorts/providers": "workspace:*",
    "@shorts/agents": "workspace:*",
    "@shorts/rendering": "workspace:*",
    "@shorts/pipeline": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

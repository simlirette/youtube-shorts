{
  "name": "youtube-shorts-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Automated faceless YouTube Shorts media-production engine",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint",
    "typecheck": "tsc --build --noEmit",
    "cli": "tsx apps/cli/src/index.ts",
    "pipeline:mock": "tsx apps/cli/src/index.ts pipeline --mock",
    "api": "tsx apps/api/src/index.ts",
    "dev": "pnpm api"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
